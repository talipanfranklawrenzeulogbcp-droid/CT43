<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
(function () {
  const health = <?=json_encode($healthChart, JSON_UNESCAPED_SLASHES)?>;
  const issuance = <?=json_encode($assetIssuanceChart, JSON_UNESCAPED_SLASHES)?>;
  const barCanvas = document.getElementById('healthGovernanceBarChart');
  const lineCanvas = document.getElementById('assetIssuanceLineChart');
  if (barCanvas && window.Chart) {
    new Chart(barCanvas, {
      type: 'bar',
      data: {
        labels: health.labels,
        datasets: [{
          label: 'Health, Safety & Governance records',
          data: health.values,
          borderWidth: 1,
          borderRadius: 6
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        scales: { y: { beginAtZero: true, ticks: { precision: 0 } } },
        plugins: { legend: { position: 'top' } }
      }
    });
  }
  if (lineCanvas && window.Chart) {
    new Chart(lineCanvas, {
      type: 'line',
      data: {
        labels: issuance.labels,
        datasets: issuance.datasets.map(function (dataset) {
          return Object.assign({pointHoverRadius: 6}, dataset);
        })
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        scales: { y: { beginAtZero: true, ticks: { precision: 0 } } },
        plugins: { legend: { position: 'top' } }
      }
    });
  }
})();
</script>

<?php if (($u=current_user()) && ($u['role'] ?? '') === 'Administrator'):
$staffActivity=service('reports')->staffActivity(30);
$staffCounts=service('reports')->staffActivityCounts();
?>
<section class="gw-panel staff-tracking-panel" style="margin-top:20px">
  <div class="gw-panel-head"><h2>Staff Activity Tracking</h2><span>Health, Safety &amp; Welfare · Legal &amp; Compliance · Asset &amp; Equipment Issuance</span></div>
  <div class="gw-stats" style="margin-top:0">
  <?php
  $labels=[
    'Health, Safety & Welfare'=>'Health, Safety & Welfare',
    'Legal & Compliance'=>'Legal & Compliance',
    'Asset & Equipment Issuance'=>'Asset & Equipment Issuance'
  ];
  foreach($labels as $key=>$label):
    $count=0; foreach($staffCounts as $sc){ if($sc['module']===$key){$count=(int)$sc['activity_count'];break;} }
  ?>
    <div class="gw-stat"><span class="gw-stat-label"><?=e($label)?></span><div class="gw-stat-value"><?=e($count)?></div><div class="gw-stat-meta">Staff actions recorded</div></div>
  <?php endforeach; ?>
  </div>
  <div class="table-wrap" style="margin-top:18px"><table class="data-table">
    <thead><tr><th>Staff</th><th>Module</th><th>Action</th><th>Details</th><th>Date &amp; Time</th></tr></thead>
    <tbody>
    <?php foreach($staffActivity as $a): ?>
      <tr><td><?=e($a['staff_name'])?><br><small><?=e($a['email'])?></small></td><td><?=e($a['module'])?></td><td><?=e($a['action'])?></td><td><?=e($a['details'])?></td><td><?=e($a['created_at'])?></td></tr>
    <?php endforeach; ?>
    <?php if(!$staffActivity): ?><tr><td colspan="5" class="empty">No staff activity has been recorded yet.</td></tr><?php endif; ?>
    </tbody>
  </table></div>
</section>
<?php endif; ?>

<?php page_footer(); ?>
